# Copy to .env.local and fill in the server-side settings.
# OPEN_AI_KEY is accepted as an alias for OPENAI_API_KEY.
OPENAI_API_KEY=

# A stable local allowance ID of 8-80 letters, digits, underscores or hyphens.
# Set a limit between 1 and 100. Zero keeps the scan button unavailable.
OPENAI_ALLOWANCE_ID=
OPENAI_REQUEST_LIMIT=0
# Defaults to this checkout's .receipt-reader-state/openai directory.
OPENAI_ALLOWANCE_DIRECTORY=
