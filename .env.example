# On-device OCR needs no API key. Optional Gemini reader:
# Copy this file to .env.local, set your key there, then restart npm run dev/preview.
# Never prefix the key with VITE_: it must remain on the local server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# A key alone does not enable uploads. One whole-receipt request uses one slot,
# including errors/timeouts. Check provider quota before setting a finite cap.
# Same grant + directory retains usage across restart/key/model changes.
# Do not reset/delete the ledger or rotate the grant to bypass a used allowance.
GEMINI_ALLOWANCE_ID=
GEMINI_REQUEST_LIMIT=0
GEMINI_ALLOWANCE_DIRECTORY=

# Optional model on this computer. Requires the separate Python/model setup.
# Absolute interpreter path; never use a VITE_ prefix. Empty keeps on-device OCR.
LOCAL_OCR_PYTHON=
LOCAL_OCR_ENGINE=paddle-v6

# Optional pinned local vision model; requires the separate public model/runtime setup.
# Uses LOCAL_OCR_PYTHON to validate images. 1 enables the experimental local reader.
LOCAL_VISION_ENABLED=0

# Optional Veryfi text reader. Keys stay server-side. Key presence alone does not enable uploads.
VERYFI_CLIENT_ID=
VERYFI_BEARER_KEY=
# Explicit finite allowance, reserved before a request and retained across restarts/failures.
# Set only after checking unused quota on the API account. Never auto-reset the grant ID.
VERYFI_ALLOWANCE_ID=
VERYFI_DOCUMENT_LIMIT=0
# Optional shared persistent directory; defaults to this project's ignored .receipt-reader-state/.
VERYFI_ALLOWANCE_DIRECTORY=

# Optional Azure receipt word reader. These server-only settings do not enable uploads alone.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Each prepared JPEG section consumes one persistent slot, including failed requests.
# Set a finite allowance only after checking unused provider quota and approving uploads.
AZURE_ALLOWANCE_ID=
AZURE_SECTION_LIMIT=0
AZURE_ALLOWANCE_DIRECTORY=
