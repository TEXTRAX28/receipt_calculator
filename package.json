{
  "name": "gather-receipt-splitter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run prepare:pdf",
    "dev": "vite --host 127.0.0.1 --port 5175 --configLoader native",
    "prebuild": "npm run prepare:pdf",
    "build": "npm run typecheck && vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --configLoader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.openai.config.ts",
    "test:e2e:webkit": "playwright test --config playwright.webkit.config.ts",
    "format": "prettier --write src server tests scripts *.ts *.json *.html",
    "format:check": "prettier --check src server tests scripts *.ts *.json *.html",
    "prepare:ocr": "node scripts/prepare-ocr.mjs && node scripts/prepare-pdf.mjs && node scripts/prepare-enhanced-ocr.mjs",
    "setup:enhanced": "node scripts/prepare-enhanced-ocr.mjs --download",
    "postinstall": "npm run prepare:pdf",
    "prepare:pdf": "node scripts/prepare-pdf.mjs"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
