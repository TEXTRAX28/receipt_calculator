{
  "name": "gather-receipt-splitter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run prepare:pdf",
    "dev": "vite --host 127.0.0.1 --port 5175 --configLoader native",
    "prebuild": "npm run prepare:pdf",
    "build": "npm run typecheck && vite build --configLoader native",
    "start": "node scripts/start.mjs",
    "preview": "npm start",
    "preview:phone": "node scripts/phone-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "playwright test --config playwright.webkit.config.ts",
    "format": "prettier --write src server tests scripts *.ts *.json *.html",
    "format:check": "prettier --check src server tests scripts *.ts *.json *.html",
    "prepare:pdf": "node scripts/prepare-pdf.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
