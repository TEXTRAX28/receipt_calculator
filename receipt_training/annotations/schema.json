{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gather:receipt-label:1.0",
  "title": "Gather receipt evidence, version 1.0",
  "type": "object",
  "required": ["schema_version", "receipt_id", "verification", "merchant", "date", "country", "currency", "items", "discounts", "fees", "subtotal", "tax", "rounding", "grand_total", "payments", "prices_include_tax", "raw_codes", "review_flags"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "verification": {
      "type": "object",
      "required": ["status", "model_generated", "visual_review", "notes"],
      "properties": {
        "status": { "enum": ["upstream_annotations", "manual_visual_partial", "pending_manual_transcription", "provisional_model", "human_verified"] },
        "model_generated": { "type": "boolean" },
        "visual_review": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "merchant": { "$ref": "#/$defs/field" },
    "date": { "$ref": "#/$defs/field" },
    "country": { "$ref": "#/$defs/field" },
    "currency": { "$ref": "#/$defs/field" },
    "subtotal": { "$ref": "#/$defs/field" },
    "tax": { "$ref": "#/$defs/field" },
    "rounding": { "$ref": "#/$defs/field" },
    "grand_total": { "$ref": "#/$defs/field" },
    "prices_include_tax": { "type": ["boolean", "null"] },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "discounts": { "type": "array", "items": { "type": "object", "required": ["item_id", "amount", "association"], "properties": { "item_id": { "type": ["string", "null"] }, "amount": { "$ref": "#/$defs/field" }, "association": { "type": "string" } } } },
    "fees": { "type": "array", "items": { "type": "object", "required": ["kind", "amount"], "properties": { "kind": { "type": "string" }, "amount": { "$ref": "#/$defs/field" } } } },
    "payments": { "type": "array", "items": { "type": "object", "required": ["kind", "amount"], "properties": { "kind": { "type": "string" }, "amount": { "$ref": "#/$defs/field" } } } },
    "raw_codes": { "type": "array", "items": { "type": "object", "required": ["text", "nearby_amount_raw", "position", "meaning", "review_required"], "properties": { "text": { "type": "string" }, "nearby_amount_raw": { "type": ["string", "null"] }, "position": { "type": "string" }, "meaning": { "type": ["string", "null"] }, "review_required": { "type": "boolean" } } } },
    "review_flags": { "type": "array", "items": { "type": "string" } },
    "coverage": { "type": "object", "properties": { "item_metrics_eligible": { "type": "boolean" }, "items_complete_for_visible_body": { "type": "boolean" }, "full_receipt_visible": { "type": "boolean" }, "tax_legend_visible": { "type": "boolean" } } }
  },
  "$defs": {
    "field": {
      "type": "object",
      "required": ["raw", "value", "review_required"],
      "properties": { "raw": {}, "value": { "type": ["string", "null"] }, "review_required": { "type": "boolean" } },
      "allOf": [{ "if": { "properties": { "value": { "type": "null" } } }, "then": { "properties": { "review_required": { "const": true } } } }]
    },
    "item": {
      "type": "object",
      "required": ["id", "description", "item_number", "quantity", "unit", "pack_size", "unit_price", "line_total", "discount", "tax_code", "line_total_basis", "raw"],
      "properties": {
        "id": { "type": "string" }, "description": { "$ref": "#/$defs/field" },
        "item_number": { "$ref": "#/$defs/field" }, "quantity": { "$ref": "#/$defs/field" },
        "unit": { "$ref": "#/$defs/field" }, "pack_size": { "$ref": "#/$defs/field" },
        "unit_price": { "$ref": "#/$defs/field" }, "line_total": { "$ref": "#/$defs/field" },
        "discount": { "$ref": "#/$defs/field" }, "tax_code": { "$ref": "#/$defs/field" },
        "line_total_basis": { "type": "string" }, "raw": { "type": "object" }
      }
    }
  }
}
